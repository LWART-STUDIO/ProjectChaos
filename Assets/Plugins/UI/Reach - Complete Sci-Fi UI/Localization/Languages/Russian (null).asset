      spriteValue: {fileID: 0}
    - key: NewsItemDescription1
      value: "\u042D\u0442\u043E \u043F\u0430\u043D\u0435\u043B\u044C, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
        \u043C\u043E\u0436\u043D\u043E \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u044C
        \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F,
        \u0441\u043F\u0438\u0441\u043E\u043A \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439
        \u0438 \u043C\u043D\u043E\u0433\u043E\u0435 \u0434\u0440\u0443\u0433\u043E\u0435."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: NewsItemTitle2
      value: "\u041F\u043E\u043B\u043D\u0430\u044F \u043D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0430"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: NewsItemDescription2
      value: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C
        \u043D\u043E\u0432\u044B\u0435 \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B,
        \u043C\u0435\u043D\u044F\u0442\u044C \u0440\u0430\u0437\u043C\u0435\u0440
        \u0438\u043B\u0438 \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u0432\u0438\u0434
        \u043F\u0430\u043D\u0435\u043B\u0438, \u043D\u0430\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044F
        \u043F\u0440\u0435\u0441\u0435\u0442 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: NewsItemTitle3
      value: "\u041B\u0451\u0433\u043A\u043E\u0435 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u0435
        \u043A\u043E\u043D\u0442\u0435\u043D\u0442\u0430"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: NewsItemDescription3
      value: "\u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043B\u0435\u0433\u043A\u043E
        \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0442\u044C \u043D\u043E\u0432\u044B\u0435
        \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u044B \u0441\u043B\u0430\u0439\u0434\u0435\u0440\u0430
        \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u0430
