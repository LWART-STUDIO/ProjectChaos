        \u043F\u043E\u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
        \u0441 \u044D\u0442\u0438\u043C \u043F\u043E\u043B\u0437\u0443\u043D\u043A\u043E\u043C."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ResolutionDesc
      value: "\u042D\u043A\u0440\u0430\u043D\u044B \u0441 \u0431\u043E\u043B\u0435\u0435
        \u0432\u044B\u0441\u043E\u043A\u0438\u043C \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435\u043C
        \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B \u0432\u043E\u0441\u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C
        \u0431\u043E\u043B\u0435\u0435 \u0447\u0435\u0442\u043A\u0438\u0435, \u044F\u0441\u043D\u044B\u0435
        \u0438 \u0434\u0435\u0442\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
        \u0438\u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u044F. \u0412\u044B
        \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
        \u043B\u044E\u0431\u043E\u0435 \u0436\u0435\u043B\u0430\u0435\u043C\u043E\u0435
        \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u0435."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: SettingsDesc
      value: "\u041D\u0430\u0441\u0442\u0440\u043E\u0439\u0442\u0435 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u044B \u0438 \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
        \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441
        \u0435\u0449\u0435 \u043B\u0443\u0447\u0448\u0435! \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
        \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u044C\u0441\u044F
        \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u044F\u043C\u0438
        \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043A\u043D\u043E\u043F\u043E\u043A
        \u0432\u0432\u0435\u0440\u0445\u0443."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: VSyncLabel
      value: VSync
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: VSyncDesc
      value: "VSync \u2014 \u044D\u0442\u043E \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0430\u044F
        \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F, \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0449\u0430\u044F
        \u0437\u0430 \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044E
        \u0447\u0430\u0441\u0442\u043E\u0442\u044B \u043A\u0430\u0434\u0440\u043E\u0432
        \u0438\u0433\u0440\u044B \u0441 \u0447\u0430\u0441\u0442\u043E\u0442\u043E\u0439
        \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430.
        \u042D\u0442\u0430 \u0441\u0438\u043D\u0445\u0440\u043E\u043D\u0438\u0437\u0430\u0446\u0438\u044F
        \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442
        \u043F\u043B\u0430\u0432\u043D\u044B\u0439 \u0438 \u043D\u0435\u043F\u0440\u0435\u0440\u044B\u0432\u043D\u044B\u0439
        \u0438\u0433\u0440\u043E\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u0441\u0441
        \u0432 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0435\u043C\u043A\u0438\u0445
        3D-\u0438\u0433\u0440\u0430\u0445."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: FrameRateLabel
      value: "\u0427\u0430\u0441\u0442\u043E\u0442\u0430 \u043A\u0430\u0434\u0440\u043E\u0432"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: FrameRateDesc
      value: "\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u044C\u0442\u0435 \u0447\u0430\u0441\u0442\u043E\u0442\u0443
        \u043A\u0430\u0434\u0440\u043E\u0432. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
        \u0441\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u0442\u044C \u044D\u0442\u043E\u0442
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 \u0441 \u0447\u0430\u0441\u0442\u043E\u0442\u043E\u0439
        \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F \u0432\u0430\u0448\u0435\u0433\u043E
        \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430. \u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435
        \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0447\u0442\u043E \u044D\u0442\u043E\u0442
        \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440 \u043D\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442,
        \u0435\u0441\u043B\u0438 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0430
        \u0444\u0443\u043D\u043A\u0446\u0438\u044F VSync."
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
