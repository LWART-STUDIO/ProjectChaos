      spriteValue: {fileID: 0}
    - key: AchievementHiddenTitle
      value: "\u0421\u043A\u0440\u044B\u0442\u043E\u0435 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0435"
