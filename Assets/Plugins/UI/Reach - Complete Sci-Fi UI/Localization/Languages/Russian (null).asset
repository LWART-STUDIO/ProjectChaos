    - key: ChapterUnlocked
      value: "\u0420\u0430\u0437\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043E"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: ChapterLocked
      value: "\u0417\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043E"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter1Title
      value: "\u0413\u043B\u0430\u0432\u0430 1"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter1Description
      value: "\u042D\u0442\u043E \u043F\u043E\u043B\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F.
        \u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u043E \u0433\u043B\u0430\u0432\u0435. \u042D\u0442\u043E \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u0440\u043E\u0447\u043D\u043E\u0435
        \u043F\u043E\u043B\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E\u0434 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435.
        \u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043B\u044E\u0431\u043E\u0439 \u0444\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
        \u0442\u0435\u043A\u0441\u0442, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u044B\u0439
        TMP. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
        \xABChapter Manager\xBB \u0434\u043B\u044F \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u044F
        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0432 \u043F\u0430\u043D\u0435\u043B\u044C
        \u0433\u043B\u0430\u0432\u044B \u2014 \u044D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter2Title
      value: "\u0413\u043B\u0430\u0432\u0430 2"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter2Description
      value: "\u042D\u0442\u043E \u043F\u043E\u043B\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F.
        \u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u043E \u0433\u043B\u0430\u0432\u0435. \u042D\u0442\u043E \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u0440\u043E\u0447\u043D\u043E\u0435
        \u043F\u043E\u043B\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E\u0434 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435.
        \u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043B\u044E\u0431\u043E\u0439 \u0444\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
        \u0442\u0435\u043A\u0441\u0442, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u044B\u0439
        TMP. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
        \xABChapter Manager\xBB \u0434\u043B\u044F \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u044F
        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0432 \u043F\u0430\u043D\u0435\u043B\u044C
        \u0433\u043B\u0430\u0432\u044B \u2014 \u044D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter3Title
      value: "\u0413\u043B\u0430\u0432\u0430 3"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter3Description
      value: "\u042D\u0442\u043E \u043F\u043E\u043B\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F.
        \u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u043E \u0433\u043B\u0430\u0432\u0435. \u042D\u0442\u043E \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u0440\u043E\u0447\u043D\u043E\u0435
        \u043F\u043E\u043B\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E\u0434 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435.
        \u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043B\u044E\u0431\u043E\u0439 \u0444\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
        \u0442\u0435\u043A\u0441\u0442, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u044B\u0439
        TMP. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
        \xABChapter Manager\xBB \u0434\u043B\u044F \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u044F
        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0432 \u043F\u0430\u043D\u0435\u043B\u044C
        \u0433\u043B\u0430\u0432\u044B \u2014 \u044D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E!"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter4Title
      value: "\u0413\u043B\u0430\u0432\u0430 4"
      audioValue: {fileID: 0}
      spriteValue: {fileID: 0}
    - key: Chapter4Description
      value: "\u042D\u0442\u043E \u043F\u043E\u043B\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F.
        \u0417\u0434\u0435\u0441\u044C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C
        \u043E \u0433\u043B\u0430\u0432\u0435. \u042D\u0442\u043E \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u0440\u043E\u0447\u043D\u043E\u0435
        \u043F\u043E\u043B\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
        \u043F\u043E\u0434 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435.
        \u0412\u044B \u0442\u0430\u043A\u0436\u0435 \u043C\u043E\u0436\u0435\u0442\u0435
        \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043B\u044E\u0431\u043E\u0439 \u0444\u043E\u0440\u043C\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
        \u0442\u0435\u043A\u0441\u0442, \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043C\u044B\u0439
        TMP. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0439\u0442\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442
        \xABChapter Manager\xBB \u0434\u043B\u044F \u0432\u043D\u0435\u0441\u0435\u043D\u0438\u044F
        \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439 \u0432 \u043F\u0430\u043D\u0435\u043B\u044C
        \u0433\u043B\u0430\u0432\u044B \u2014 \u044D\u0442\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
        \u043F\u0440\u043E\u0441\u0442\u043E!"
